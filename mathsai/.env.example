ANTHROPIC_API_KEY=
DATABASE_URL=sqlite:///./mathsai.db
ENVIRONMENT=development

# Comma-separated list of allowed CORS origins — never "*". Only relevant if
# a frontend is ever run against this API from a different origin than the
# one serving it (e.g. the Vite dev server, or a split frontend/backend
# deployment); the normal single-container deployment path serves both from
# the same origin, so this never applies there. No APP_PASSWORD_HASH is
# needed — this system runs privately over Tailscale, not public hosting
# (see README → Network access).
FRONTEND_ORIGIN=http://localhost:5173
