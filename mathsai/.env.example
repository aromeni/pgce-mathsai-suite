ANTHROPIC_API_KEY=
DATABASE_URL=sqlite:///./mathsai.db

# 'development' or 'production'. Setting this to 'production' switches on a
# startup check that refuses to boot unless APP_PASSWORD_HASH and SECRET_KEY
# are both set, and makes the session cookie HTTPS-only.
ENVIRONMENT=development

# Authentication (backend/auth.py).
#
# Leave both blank locally and the app runs with no login, exactly as it did
# before. In production they are mandatory — the app will not start without
# them, because a public URL with open /refresh routes lets anyone spend
# Anthropic credits on your key.
#
# Generate the hash (never store the password itself):
#   cd backend && python generate_password_hash.py
APP_PASSWORD_HASH=
# Signs the session cookie. Any long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Comma-separated list of allowed CORS origins — never "*". Only relevant if
# a frontend is ever run against this API from a different origin than the
# one serving it (e.g. the Vite dev server, or a split frontend/backend
# deployment); the normal single-container deployment path serves both from
# the same origin, so this never applies there.
FRONTEND_ORIGIN=http://localhost:5173
